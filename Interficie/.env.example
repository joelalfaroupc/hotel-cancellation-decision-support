# SMTP account used by both:
# - high-risk operational emails from the dashboard
# - booking confirmation emails from reserva_web.html
EMAIL_ADDRESS=hotel@example.com
EMAIL_PASSWORD=app-password-or-smtp-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465

# Only needed for the high-risk email agent that drafts text with OpenAI.
# Booking confirmation emails do not use OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
